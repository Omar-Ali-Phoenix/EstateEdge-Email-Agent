# Local development only. Copy to .env (git-ignored) and fill in.
# A deployed stack does NOT use this file: the Lambdas get their settings from
# template.yaml, which gets them from deployment.config.
# Never put real credentials in this file; AWS credentials come from your CLI profile.

LOCAL_MODE=1
AWS_REGION=<aws-region>
BEDROCK_MODEL_ID=<model-or-inference-profile-id>
AGENT_ENGINE=strands

# Database through the RDS Data API
DATA_API_CLUSTER_ARN=<aurora-cluster-arn>
DATA_API_SECRET_ARN=<secrets-manager-secret-arn>
DB_NAME=<database-name>
DB_TABLE=<view_name>

# Branding and behaviour
BRAND_NAME=Property Assistant
CURRENCY_CODE=<currency-code>
LANGUAGE_HINT=

# Email (SES)
SES_SENDER=<agent@mail.your-domain.com>
SALES_TEAM_EMAIL=<sales@your-company.com>
